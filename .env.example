# ─────────────────────────────────────────────────────────────
# MANTRA SPORTS CA — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mantra Sports CA"
NEXT_PUBLIC_REGION=ca

# ── Database (Neon Postgres) ─────────────────────────────────
# Local development — point at a local Postgres or a Neon dev branch
DATABASE_URL=postgresql://postgres:password@localhost:5432/mantra_sports_ca

# Production — Neon pooled connection string
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DATABASE?sslmode=require

# ── Authentication ────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=TO_BE_GENERATED

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=TO_BE_PROVIDED
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=TO_BE_PROVIDED
SMTP_PASS=TO_BE_PROVIDED
SMTP_FROM="Mantra Sports CA <noreply@mantrasports.ca>"

# Enquiry destination — all enquiries are sent here
EMAIL_TO=TO_BE_PROVIDED

# ── WhatsApp ─────────────────────────────────────────────────
# International format without +, e.g. 14165551234
NEXT_PUBLIC_WHATSAPP_NUMBER=TO_BE_PROVIDED

# ── Image Uploads (Cloudinary) ───────────────────────────────
# Used by the Media Library (server-side signed upload via /api/admin/upload).
# Without these set, uploads fall back to /public/uploads locally (dev only —
# not persistent on Vercel). Required for production.
CLOUDINARY_CLOUD_NAME=TO_BE_PROVIDED
CLOUDINARY_API_KEY=TO_BE_PROVIDED
CLOUDINARY_API_SECRET=TO_BE_PROVIDED
UPLOAD_MAX_SIZE_MB=10

# Used by Product/Settings forms (client-side direct-to-Cloudinary unsigned upload).
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET must be created in Cloudinary as an
# "Unsigned" upload preset — see Settings > Upload > Upload presets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=TO_BE_PROVIDED
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=TO_BE_PROVIDED

# ── MantraOS Integration ─────────────────────────────────────
# Mirrors every enquiry into MantraOS as a lead Opportunity. Get this
# from MantraOS: Settings > Lead Intake > Create key (company:
# Mantra Sports Canada Inc.). Treat like a password.
MANTRA_LEAD_INTAKE_KEY=TO_BE_PROVIDED

# ── Payments (Future — DO NOT ENABLE YET) ────────────────────
# PAYPAL_CLIENT_ID=TO_BE_PROVIDED
# PAYPAL_CLIENT_SECRET=TO_BE_PROVIDED
# PAYPAL_MODE=sandbox

# ── Analytics (Future) ───────────────────────────────────────
# NEXT_PUBLIC_GA_ID=TO_BE_PROVIDED
